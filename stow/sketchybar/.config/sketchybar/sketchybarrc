#!/bin/bash
# Adapted from https://github.com/wthrajat/dotfiles-mac/tree/main/sketchybar
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
source "$CONFIG_DIR/colors.sh"
export PLUGIN_DIR="$CONFIG_DIR/plugins"
export NOW_PLAYING_BIN="$CONFIG_DIR/helpers/sketchybar-now-playing"
export NOW_PLAYING_CONFIG="$CONFIG_DIR/now-playing.toml"
FONT="Hack Nerd Font Mono"

# 30 px pills within the existing 38 px window gap: 4 px above and below.
sketchybar --bar height=30 margin=0 y_offset=4 position=top \
  corner_radius=0 border_width=0 color="$TRANSPARENT" blur_radius=0 \
  shadow=off sticky=on topmost=window font_smoothing=on \
  padding_left=4 padding_right=12 drawing=on hidden=off

sketchybar --default updates=when_shown \
  icon.font="$FONT:Regular:16.0" icon.color="$SUBTEXT" \
  icon.padding_left=0 icon.padding_right=0 \
  label.font="$FONT:Regular:13.0" label.color="$TEXT" \
  label.padding_left=0 label.padding_right=0 \
  padding_left=0 padding_right=0 y_offset=0 \
  background.drawing=off background.color="$TRANSPARENT" \
  background.border_width=0 scroll_texts=off

# One translucent background around each group, with room between pills.
pill() {
  sketchybar --set "$1" background.drawing=on \
    background.color="$PILL_BG" background.corner_radius=12 \
    background.height=30 background.border_width=1 \
    background.border_color="$PILL_BORDER" blur_radius=30
}
gap() {
  local width=8
  sketchybar --add item "$1" "$2" --set "$1" width="$width" \
    icon.drawing=off label.drawing=off background.drawing=off
}

source "$CONFIG_DIR/items/spaces.sh"
gap gap_workspaces_music left
source "$CONFIG_DIR/items/now_playing.sh"

# Right-side items are added from the outer edge inwards.
sketchybar --default background.drawing=on background.color="$PILL_BG" \
  background.corner_radius=12 background.height=30 \
  background.border_width=1 background.border_color="$PILL_BORDER" \
  blur_radius=30 icon.color="$SKY" icon.padding_left=12 \
  icon.padding_right=5 label.padding_left=5 label.padding_right=12

status() {
  sketchybar --add item "$1" right --set "$1" icon="$2" label="$3" \
    script="$PLUGIN_DIR/status.sh" update_freq="$4"
}
status time '' "$(date '+%I:%M %p')" 30
sketchybar --subscribe time system_woke
gap gap_battery_time right
status battery '' '--%' 60
sketchybar --subscribe battery power_source_change system_woke
gap gap_battery_date right
status date '' "$(date '+%d %b %a')" 60
sketchybar --subscribe date system_woke
gap gap_date_cpu right
status cpu '' '--%' 10
gap gap_cpu_memory right
status memory '' '--% | --G' 10
gap gap_memory_temp right
status temp '' '--°C' 15
sketchybar --subscribe temp system_woke

# The media helper belongs to this bar; no launch agent or system install.
# Its own lock also prevents duplicate daemons during concurrent reloads.
if [ -x "$NOW_PLAYING_BIN" ] && ! pgrep -f '[s]ketchybar-now-playing daemon' >/dev/null 2>&1; then
  "$NOW_PLAYING_BIN" daemon --config "$NOW_PLAYING_CONFIG" \
    --event now_playing_change >/tmp/sketchybar-glass-media.log 2>&1 &
fi

sketchybar --update
